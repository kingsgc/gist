# Supabase (live mode) — from Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# share attribution domain (e.g. https://gist.app)
EXPO_PUBLIC_SHARE_DOMAIN=gist

# --- Built-in AI assistant ("Gisty AI") --------------------------------
# Any OpenAI-compatible chat-completions endpoint works.
# Leave EXPO_PUBLIC_AI_API_KEY empty to run the assistant in offline mode.
EXPO_PUBLIC_AI_API_KEY=
EXPO_PUBLIC_AI_BASE_URL=https://api.openai.com/v1
EXPO_PUBLIC_AI_MODEL=gpt-4o-mini
